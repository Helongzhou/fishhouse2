{
  "language": "en",
  "entries": [
    {
      "key": "compatibility.reason.ADULT_MALE_BETTA_CONSPECIFIC_BLOCK.message",
      "value": "Multiple adult male {source} cannot share this tank."
    },
    {
      "key": "compatibility.reason.ADULT_MALE_BETTA_CONSPECIFIC_BLOCK.repair",
      "value": "House adult males in separate suitable systems. Do not rely on a larger group or individual temperament."
    },
    {
      "key": "compatibility.reason.ADULT_SPACE_INSUFFICIENT.message",
      "value": "The adult space requirement for {source} is not met at {target}."
    },
    {
      "key": "compatibility.reason.ADULT_SPACE_INSUFFICIENT.repair",
      "value": "Use a tank that meets adult length, height and usable swimming-space requirements, or choose a suitable species."
    },
    {
      "key": "compatibility.reason.ADULT_SPACE_UNKNOWN.message",
      "value": "The adult space requirement or available space for {source} at {target} is unverified."
    },
    {
      "key": "compatibility.reason.ADULT_SPACE_UNKNOWN.repair",
      "value": "Confirm adult requirements and usable space after substrate and hardscape displacement. Juveniles still require an adult plan."
    },
    {
      "key": "compatibility.reason.BETTA_CONSPECIFIC_CONDITIONS_REVIEW.message",
      "value": "No multiple-adult-male rule was triggered for {source}, but this same-species group still has unmet review conditions."
    },
    {
      "key": "compatibility.reason.BETTA_CONSPECIFIC_CONDITIONS_REVIEW.repair",
      "value": "Review individuals, sex, space, cover and management. Prepare immediate separation; V0 defaults to one individual."
    },
    {
      "key": "compatibility.reason.BETTA_SEX_OR_STAGE_UNKNOWN.message",
      "value": "Sex or life stage is unknown for {source}; adult male conflict cannot be ruled out."
    },
    {
      "key": "compatibility.reason.BETTA_SEX_OR_STAGE_UNKNOWN.repair",
      "value": "Confirm the sex and life stage of every individual before approving a same-species combination."
    },
    {
      "key": "compatibility.reason.BOTTOM_SIFTER_FOOD_UNKNOWN.message",
      "value": "Appropriate sinking food for {source} has not been confirmed."
    },
    {
      "key": "compatibility.reason.BOTTOM_SIFTER_FOOD_UNKNOWN.repair",
      "value": "Provide species-appropriate sinking food. Feces and leftovers are not an adequate feeding plan."
    },
    {
      "key": "compatibility.reason.BOTTOM_SIFTER_NEEDS_SINKING_FOOD.message",
      "value": "No appropriate sinking-food plan is present for {source}."
    },
    {
      "key": "compatibility.reason.BOTTOM_SIFTER_NEEDS_SINKING_FOOD.repair",
      "value": "Provide suitable sinking food and observe feeding. Bottom-sifting fish are not feces cleaners."
    },
    {
      "key": "compatibility.reason.BOTTOM_SIFTER_NEEDS_SOFT_SAND.message",
      "value": "The modeled soft-sand foraging requirement of {source} is unmet."
    },
    {
      "key": "compatibility.reason.BOTTOM_SIFTER_NEEDS_SOFT_SAND.repair",
      "value": "Provide a safe, accessible soft-sand foraging area and reassess. Sifting does not remove the need for waste management."
    },
    {
      "key": "compatibility.reason.BOTTOM_SIFTER_SUBSTRATE_UNKNOWN.message",
      "value": "The foraging substrate for {source} is unverified."
    },
    {
      "key": "compatibility.reason.BOTTOM_SIFTER_SUBSTRATE_UNKNOWN.repair",
      "value": "Confirm a safe soft-sand substrate for this bottom-sifting profile."
    },
    {
      "key": "compatibility.reason.COMMUNITY_RANGE_EMPTY.message",
      "value": "The whole-community water-parameter intersection is empty; {source} and {target} define conflicting bounds."
    },
    {
      "key": "compatibility.reason.COMMUNITY_RANGE_EMPTY.repair",
      "value": "Separate incompatible species or remove a conflicting member, then recompute the entire combination. A freshwater label is insufficient."
    },
    {
      "key": "compatibility.reason.COMMUNITY_WATER_TYPE_MISMATCH.message",
      "value": "{source} and {target} require different water systems."
    },
    {
      "key": "compatibility.reason.COMMUNITY_WATER_TYPE_MISMATCH.repair",
      "value": "Separate freshwater, brackish and saltwater requirements into suitable systems; do not invent a compromise water type."
    },
    {
      "key": "compatibility.reason.CONTENT_POLICY_UNKNOWN.message",
      "value": "The V0 purchasing policy for {source} is unknown."
    },
    {
      "key": "compatibility.reason.CONTENT_POLICY_UNKNOWN.repair",
      "value": "Have the content owner confirm purchasable_v0, planned or reference_only."
    },
    {
      "key": "compatibility.reason.DIRECTIONAL_FIN_NIPPING_RISK.message",
      "value": "{source} may nip the fins of {target}; source group size is {source_count}. This is a risk, not a guaranteed attack."
    },
    {
      "key": "compatibility.reason.DIRECTIONAL_FIN_NIPPING_RISK.repair",
      "value": "Prefer separating the fin-nipping source and long-finned target. Review group size, space and stress; adequate numbers do not guarantee safety."
    },
    {
      "key": "compatibility.reason.GAPE_PREDATION_RISK.message",
      "value": "The gape of {source} is not smaller than the body cross-section of {target}; size-related predation is possible."
    },
    {
      "key": "compatibility.reason.GAPE_PREDATION_RISK.repair",
      "value": "Separate potential prey or use a dedicated nursery. Cover does not guarantee survival; reassess as animals grow."
    },
    {
      "key": "compatibility.reason.INCONSISTENT_SPECIES_PROFILE.message",
      "value": "The same species ID {source} uses inconsistent profile instances."
    },
    {
      "key": "compatibility.reason.INCONSISTENT_SPECIES_PROFILE.repair",
      "value": "Reference one reviewed profile version for all cohorts of the same species."
    },
    {
      "key": "compatibility.reason.INVALID_STOCK_GROUP.message",
      "value": "{target} has a missing species/group ID, duplicate group ID, or a non-positive count."
    },
    {
      "key": "compatibility.reason.INVALID_STOCK_GROUP.repair",
      "value": "Provide a reviewed species, unique group ID and positive integer count, then reassess."
    },
    {
      "key": "compatibility.reason.NO_VALID_STOCK.message",
      "value": "No valid stock group is available for assessment."
    },
    {
      "key": "compatibility.reason.NO_VALID_STOCK.repair",
      "value": "Add at least one reviewed species cohort; an empty or invalid composition is not an approval."
    },
    {
      "key": "compatibility.reason.PREDATION_PROFILE_UNKNOWN.message",
      "value": "The ability of {source} to prey on smaller animals is unverified."
    },
    {
      "key": "compatibility.reason.PREDATION_PROFILE_UNKNOWN.repair",
      "value": "Confirm diet and size-related predation capability. Do not infer safety or total loss from fish/shrimp categories."
    },
    {
      "key": "compatibility.reason.PREDATION_SIZE_UNKNOWN.message",
      "value": "Gape or current body cross-section data for {source} and {target} is missing; swallowing risk is unresolved."
    },
    {
      "key": "compatibility.reason.PREDATION_SIZE_UNKNOWN.repair",
      "value": "Confirm current-stage gape and body cross-section, and separate potential prey until verified."
    },
    {
      "key": "compatibility.reason.SAME_SPECIES_GROUP_TOO_SMALL.message",
      "value": "{source} has {source_count} individuals, below its recommended same-species minimum of {required_count}. Other fish or shrimp do not count."
    },
    {
      "key": "compatibility.reason.SAME_SPECIES_GROUP_TOO_SMALL.repair",
      "value": "After reassessing space, filtration and conflicts, add the same species or choose a species with different social requirements."
    },
    {
      "key": "compatibility.reason.SPECIES_GROUP_MIN_UNKNOWN.message",
      "value": "The same-species group requirement for {source} is unknown."
    },
    {
      "key": "compatibility.reason.SPECIES_GROUP_MIN_UNKNOWN.repair",
      "value": "Verify social and conspecific-isolation requirements instead of substituting other species."
    },
    {
      "key": "compatibility.reason.SPECIES_RANGE_UNKNOWN.message",
      "value": "The reviewed {parameter} range for {source} is missing or invalid."
    },
    {
      "key": "compatibility.reason.SPECIES_RANGE_UNKNOWN.repair",
      "value": "Confirm the complete species range and reassess. Do not treat unknown data as a compatible freshwater default."
    },
    {
      "key": "compatibility.reason.SPECIES_WATER_TYPE_UNKNOWN.message",
      "value": "The water system required by {source} is unverified."
    },
    {
      "key": "compatibility.reason.SPECIES_WATER_TYPE_UNKNOWN.repair",
      "value": "Confirm the species water system; unknown must not default to freshwater."
    },
    {
      "key": "compatibility.reason.TANK_PARAMETER_OUTSIDE_SPECIES_RANGE.message",
      "value": "The current tank {parameter} is outside the reviewed range for {source}."
    },
    {
      "key": "compatibility.reason.TANK_PARAMETER_OUTSIDE_SPECIES_RANGE.repair",
      "value": "If a whole-community range exists, adjust gradually into its interior. Otherwise separate species; avoid sudden parameter changes."
    },
    {
      "key": "compatibility.reason.TANK_PARAMETER_UNKNOWN.message",
      "value": "The current tank measurement for {parameter} is missing or invalid."
    },
    {
      "key": "compatibility.reason.TANK_PARAMETER_UNKNOWN.repair",
      "value": "Measure and record the current value; compatible species ranges do not prove current water conditions are suitable."
    },
    {
      "key": "compatibility.reason.TANK_WATER_TYPE_MISMATCH.message",
      "value": "{source} requires a different water system from the current tank."
    },
    {
      "key": "compatibility.reason.TANK_WATER_TYPE_MISMATCH.repair",
      "value": "Move the species into a suitable independent water system."
    },
    {
      "key": "compatibility.reason.TANK_WATER_TYPE_UNKNOWN.message",
      "value": "The current tank water system is unknown."
    },
    {
      "key": "compatibility.reason.TANK_WATER_TYPE_UNKNOWN.repair",
      "value": "Confirm whether this is a freshwater, brackish or saltwater system."
    },
    {
      "key": "compatibility.reason.V0_CONTENT_NOT_PURCHASABLE.message",
      "value": "{source} is planned or reference-only and cannot be purchased in V0. This is content policy, not an ecological incompatibility claim."
    },
    {
      "key": "compatibility.reason.V0_CONTENT_NOT_PURCHASABLE.repair",
      "value": "Remove it from the V0 purchase list or wait for an approved content version."
    },
    {
      "key": "compatibility.summary.action_required",
      "value": "Review every blocking, risk, unmet-condition and unverified-data reason. Resolve and reassess before introduction."
    },
    {
      "key": "compatibility.summary.monitor",
      "value": "No modeled conflict found. Quarantine, staged introduction, monitoring and an isolation plan are still required."
    },
